# macOS folder metadata
.DS_Store

# exported pieces and renders stay out of the repo unless you add them on purpose
*.wav
*.mp3
*.mid
*.musicxml
*.mp4
*.mov
*.webm
*.zip

# piece files are your compositions; keep them out of the public repo
*.json
!source/site.json
# except the Library's examples, which the build puts into the app
!source/examples/*.json

# website build output (recreated by node source/build.js)
dist/

# release zips (made by node source/release.js)
releases/
